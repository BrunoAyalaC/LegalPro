# ConfiguraciÃ³n del Dashboard del Owner de LegalPro
PORT=3005

# URL pÃºblica de PostgreSQL (Railway o local)
DATABASE_URL=postgresql://usuario:password@host:puerto/base_de_datos

# CA certificate del servidor PostgreSQL (opcional, recomendado para produccion estricta)
# Si Railway/Render proveen CA en la cadena de conexion (sslmode=verify-full), dejar vacio.
# Solo rellenar si tu servidor PostgreSQL requiere CA custom (ej. CA privada corporativa).
DATABASE_SSL_CA=

# Clave de acceso Bearer para autenticar las peticiones al Owner Dashboard
OWNER_SECRET_KEY=ingresa_aqui_tu_clave_secreta_api

# Frase de descifrado simÃ©trico AES-256-GCM para los payloads del Dashboard
OWNER_DECRYPTION_SECRET=ingresa_aqui_tu_clave_de_descifrado
