# Dockerfile.frontend
# Generado por @devops
# Build multi-stage para producción con nginx

# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app
COPY legalpro-app/package*.json ./
RUN npm ci --no-audit --no-fund --legacy-peer-deps
COPY legalpro-app/ ./
ARG VITE_NODE_API_URL=https://legalpro-node-production-34ac.up.railway.app
ARG VITE_DOTNET_API_URL=https://legalpro-dotnet-production-5a39.up.railway.app
ARG VITE_APK_URL=https://github.com/BrunoAyalaC/Abogacia/releases/download/v1.1.0/LegalPro-v1.1.0.apk
ENV VITE_NODE_API_URL=$VITE_NODE_API_URL
ENV VITE_DOTNET_API_URL=$VITE_DOTNET_API_URL
ENV VITE_APK_URL=$VITE_APK_URL
RUN npm run build

# Stage 2: Production
FROM nginx:1.27-alpine AS production
LABEL maintainer="LegalPro DevOps <devops@legalpro.pe>"
LABEL version="1.0.0"

# Copy Railway-safe nginx config (SPA only, port 80)
COPY nginx.railway-frontend.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1

# Security: run as non-root (omit USER nginx — Railway + read-only conf)
RUN chown -R nginx:nginx /usr/share/nginx/html
RUN chown -R nginx:nginx /var/cache/nginx

EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
