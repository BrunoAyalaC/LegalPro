VITE_SUPABASE_URL=https://yddkasmxxgrmmwlotfyx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlkZGthc214eGdybW13bG90Znl4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM4MTExNDEsImV4cCI6MjA4OTM4NzE0MX0.o7PZVGc-2FGHa3g_ggM_7P908ExGCh8trMYkjDi8O3A

# URL publica del APK Android para descarga desde la web
# Sube el APK a GitHub Releases (gratis, sin egress): https://github.com/BrunoAyalaC/Abogacia/releases
VITE_APK_URL=https://github.com/BrunoAyalaC/Abogacia/releases/download/v1.0/LegalPro.apk

# ─── RAG (Retrieval Augmented Generation) ──────────────────────────────────────
# Activa la inyección de contexto de la base legal peruana (pgvector)
# en las respuestas IA. Ver legalpro-app/server/middleware/ragMiddleware.js
# Para activar: ENABLE_RAG=true (requiere OPENCODE_API_KEY + DATABASE_URL
# con la tabla rag_vectors poblada por tools/rag/setup-rag.mjs).
ENABLE_RAG=false

# Número máximo de chunks a recuperar por consulta (1-10 recomendado).
# Más chunks = más contexto, más tokens y más latencia.
RAG_TOP_K=5

# Umbral mínimo de similitud coseno (0.0 - 1.0). Default 0.70.
# Valores más altos = más estricto, menos chunks pero más relevantes.
RAG_THRESHOLD=0.70

# ─── OpenCode Go (proveedor IA principal) ────────────────────
# Plan de bajo costo de OpenCode, acceso a modelos open
# Obtener API key en https://opencode.ai/auth
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/api/v1
OPENCODE_MODEL=deepseek-v4-flash-free
OPENCODE_TEMPERATURE=0.2
OPENCODE_MAX_TOKENS=8192

# ─── Visión (MiMo V2.5 de Xiaomi, open source) ───────────────
MIMO_VISION_API_KEY=
MIMO_VISION_MODEL=xiaomi/mimo-v2.5
MIMO_VISION_BASE_URL=https://opencode.ai/api/v1

# ─── Gemini (ELIMINADO - no usar) ────────────────────────────
# GEMINI_API_KEY=  ← ELIMINADA definitivamente
