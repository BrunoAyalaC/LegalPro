# ─────────────────────────────────────────────────────────────
# LegalPro Backend Node.js — Variables de entorno
# Para DEV local: copiar a .env (NO commitear)
# Para PROD: configurar en Railway Dashboard
# ─────────────────────────────────────────────────────────────

# ═══ SERVER ═══
PORT=3001
NODE_ENV=development
APP_VERSION=1.0.0

# ═══ DATABASE ═══
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legalpro
PGSSLMODE=Disable
PG_POOL_SIZE=10
PG_STATEMENT_TIMEOUT_MS=30000
PG_IDLE_TIMEOUT_MS=10000

# ═══ AUTH / JWT ═══
# ⚠️ CAMBIAR en producción. Mínimo 32 caracteres, base64
JWT_SECRET=genera-un-secreto-de-al-menos-32-caracteres-base64-aqui
JWT_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=2592000
JWT_ISSUER=LegalProAPI
JWT_AUDIENCE=LegalProClients
BCRYPT_ROUNDS=12

# ═══ SUPABASE (Auth + Storage) ═══
# Usar valores de https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://yddkasmxxgrmmwlotfyx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlkZGthc214eGdybW13bG90Znl4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM4MTExNDEsImV4cCI6MjA4OTM4NzE0MX0.o7PZVGc-2FGHa3g_ggM_7P908ExGCh8trMYkjDi8O3A
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlkZGthc214eGdybW13bG90Znl4Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3MzgxMTE0MSwiZXhwIjoyMDg5Mzg3MTQxfQ.YYYY
SUPABASE_STORAGE_BUCKET_EVIDENCIA=evidencia

# ═══ MINIMAX API ═══
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL_DEFAULT=MiniMax-M3
MINIMAX_TEMPERATURE_DEFAULT=0.2
MINIMAX_MAX_TOKENS=8192
MINIMAX_QUOTA_ALERT_USD=500
MINIMAX_BASE_URL=https://api.minimax.io/v1

# ═══ OPENCODE GO (proveedor IA principal — OPENCODE-FIRST) ═══
# Plan de bajo costo de OpenCode, modelos open (DeepSeek V4 Flash)
# Obtener API key en https://opencode.ai/auth
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4-flash-free
OPENCODE_TEMPERATURE=0.2
OPENCODE_MAX_TOKENS=8192

# ═══ OPENROUTER (proveedor IA alternativo — multimodal + texto) ═══
# Acceso unificado a cientos de modelos (Qwen VL, DeepSeek, Claude, GPT...)
# Obtener API key en https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo de VISIÓN por defecto (Qwen VL 32B Instruct)
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-32b-instruct
# Modelo de TEXTO alternativo (DeepSeek Chat v3.1 gratis)
OPENROUTER_TEXT_MODEL=deepseek/deepseek-chat-v3.1:free
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=8192
# Headers OBLIGATORIOS para OpenRouter (rechaza requests sin ellos)
APP_REFERER=https://legalpro.ai
APP_TITLE=LegalPro

# ═══ SELECCIÓN DE PROVIDER IA ═══
# 'auto' prioriza: openrouter > opencode > minimax
# Forzar uno específico: opencode | openrouter | minimax
IA_PROVIDER=auto
# 'auto' prioriza: openrouter > opencode > minimax
VISION_PROVIDER=auto

# ═══ VISIÓN (MiMo V2.5 de Xiaomi via OpenCode, GRATIS) ═══
OPENCODE_VISION_MODEL=mimo-v2.5-free
# Legacy: ya no se usa (OpenCode Visión cubre este caso)
MIMO_VISION_API_KEY=your_mimo_vision_api_key_here
MIMO_VISION_MODEL=xiaomi/mimo-v2.5
MIMO_VISION_BASE_URL=https://opencode.ai/api/v1

# ═══ GEMINI (ELIMINADO — no usar) ═══
# GEMINI_API_KEY=  ← ELIMINADA definitivamente (2026-08-01)

# ═══ CORS ═══
# Orígenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3005
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ═══ RATE LIMITING ═══
RATE_LIMIT_MINIMAX_RPM=60
RATE_LIMIT_STANDARD_RPM=120
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MINUTES=15
IDEMPOTENCY_TTL_SECONDS=86400

# ═══ UPLOADS ═══
UPLOADS_DIR=/tmp/legalpro-uploads
MAX_UPLOAD_SIZE_MB=50

# ═══ INTEGRACIONES EXTERNAS ═══
# BCRP API (tasas de interés legal)
BCRP_API_URL=https://estadisticas.bcrp.gob.pe/estadisticas/series/api
BCRP_CACHE_TTL_SECONDS=86400
BCRP_TIMEOUT_MS=5000

# SUNAT API (futuro)
SUNAT_API_URL=https://api.sunat.gob.pe
SUNAT_TIMEOUT_MS=10000

# ═══ OBSERVABILITY ═══
LOG_LEVEL=info
CORRELATION_ID_HEADER=X-Correlation-Id
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# ═══ LPDP ═══
LPDP_BREACH_NOTIFICATION_DAYS=5
LPDP_ARCO_RESPONSE_DAYS=8
LPDP_RETENTION_DAYS=1825

# ═══ FEATURES FLAGS ═══
FEATURE_IA_LEGAL=true
FEATURE_FIRMA_DIGITAL=true
FEATURE_PAGOS_STRIPE=false
FEATURE_BCRP=true
FEATURE_SINOE_MOCK=true

# ═══ URLS INTERNAS ═══
INTERNAL_DOTNET_API_URL=http://localhost:5000
INTERNAL_OWNER_DASHBOARD_URL=http://localhost:3005

# ═══ ALERTAS ═══
SLACK_WEBHOOK_OPS=
SLACK_WEBHOOK_SECURITY=
SLACK_WEBHOOK_LPDP=
EMAIL_CTO=
EMAIL_CISO=
