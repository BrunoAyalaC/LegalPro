{
  "name": "legalpro-app",
  "private": true,
  "version": "6.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:server": "vitest run --config vitest.config.server.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:production": "vitest run --config vitest.config.prod.js server/__tests__/production",
    "test:prod:node": "vitest run --config vitest.config.prod.js server/__tests__/production/prod-node.test.js",
    "test:prod:dotnet": "vitest run --config vitest.config.prod.js server/__tests__/production/prod-dotnet.test.js",
    "test:prod:api": "vitest run --config vitest.config.prod.js",
    "test:prod:e2e": "playwright test --config playwright.config.prod.js",
    "test:prod:exhaustive": "playwright test --config=playwright.config.prod-exhaustive.mjs",
    "test:prod": "npm run test:prod:api && npm run test:prod:e2e",
    "test:lighthouse": "lighthouse http://localhost:5173 --output=json --output-path=./lighthouse.json",
    "test:axe": "axe http://localhost:5173",
    "seed": "node server/seed.mjs",
    "seed:demo": "node server/seed.mjs",
    "seed:prod": "node seed-prod.mjs",
    "seed:reset-prod": "node ../tools/seed/reset-production.mjs",
    "seed:cleanup-e2e": "node ../tools/seed/cleanup-e2e-expedientes.mjs",
    "seed:patch-lpdp": "node ../tools/seed/patch-lpdp-prod.mjs",
    "railway:status": "powershell -ExecutionPolicy Bypass -File ../tools/railway/legalpro-ops.ps1 status",
    "railway:logs": "powershell -ExecutionPolicy Bypass -File ../tools/railway/legalpro-ops.ps1 logs",
    "railway:logs:all": "powershell -ExecutionPolicy Bypass -File ../tools/railway/legalpro-ops.ps1 logs-all",
    "railway:redeploy": "powershell -ExecutionPolicy Bypass -File ../tools/railway/legalpro-ops.ps1 redeploy",
    "update-catalog": "node tools/legal-catalog-updater.mjs",
    "smoke:dev": "SMOKE_NODE_URL=http://localhost:3001 SMOKE_DOTNET_URL=http://localhost:5000 SMOKE_OWNER_URL=http://localhost:3005 node server/smoke-production.mjs",
    "backup": "node tools/backup.mjs",
    "verify:all": "for v in tools/verifiers/verifier-*.mjs; do node $v; done",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@sentry/node": "^10.58.0",
    "@sentry/profiling-node": "^10.58.0",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "axios": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dompurify": "^3.3.3",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.36.0",
    "helmet": "^8.1.0",
    "html2pdf.js": "^0.14.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.577.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "otplib": "^13.5.0",
    "pg": "^8.20.0",
    "puppeteer": "^24.42.0",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.2.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0",
    "react-intersection-observer": "^10.0.3",
    "react-is": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "serve": "^14.2.6",
    "storybook": "^8.4.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.0"
  }
}
