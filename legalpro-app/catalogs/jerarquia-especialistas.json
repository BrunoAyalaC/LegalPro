{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": "1.2.0",
  "descripcion": "Mapa de la jerarquía piramidal de especialistas legales y contables. Reemplaza la estructura plana por una pirámide con 4 niveles de expertise y 5 mega-áreas. Actualizado con el arnés ampliado de 139 agentes (137 del arnés + 2 built-in).",
  "principios": {
    "piramide": "Los casos complejos suben en la pirámide; los simples se resuelven en el nivel junior",
    "consulta_automatica": "Un agente junior consulta automáticamente al senior si su confianza < 0.8",
    "aprobacion_chief": "El chief aprueba solo casos irreversibles o cross-rama",
    "trazabilidad_total": "Cada nivel emite su audit_log con correlation_id",
    "LPDP_gradual": "Junior ve PII sanitizada; Senior ve agregada; Chief no ve PII"
  },
  "niveles": {
    "chief": {
      "descripcion": "Master / estratega con 15+ años",
      "temperatura_default": 0.1,
      "autonomia": "Total. Veto técnico. Aprueba casos complejos. Coordina senior.",
      "LPDP_acceso_PII": false,
      "responsabilidades": [
        "Aprobar casos irreversibles",
        "Coordinar cross-rama",
        "Veto técnico final",
        "Firma de releases legales (catálogos)",
        "Mentorear seniors"
      ]
    },
    "senior": {
      "descripcion": "Experto con 8-12 años, coordina juniors de su mega-área",
      "temperatura_default": 0.15,
      "autonomia": "Alta en su mega-área. Escala a chief si cross-rama o complejo.",
      "LPDP_acceso_PII": "agregada (no PII en claro)",
      "responsabilidades": [
        "Resolver casos complejos de su mega-área",
        "Coordinar 3-4 juniors",
        "Validar outputs de juniors",
        "Proponer catálogos y reglas",
        "Aprobar estrategias procesales"
      ]
    },
    "junior": {
      "descripcion": "Especialista puro con 3-5 años",
      "temperatura_default": 0.2,
      "autonomia": "Limitada a su especialidad. Consulta al senior si confianza < 0.8.",
      "LPDP_acceso_PII": "sanitizada",
      "responsabilidades": [
        "Ejecutar tareas de su especialidad",
        "Consultar catálogos",
        "Validar citas contra catálogos",
        "Escalar al senior si hay ambigüedad"
      ]
    },
    "assistant": {
      "descripcion": "Recién egresado, solo asiste",
      "temperatura_default": 0.3,
      "autonomia": "Muy limitada. Solo tareas mecánicas.",
      "LPDP_acceso_PII": "nunca",
      "responsabilidades": [
        "Búsqueda de jurisprudencia",
        "Cálculos mecánicos (CTS, liquidaciones)",
        "Redacción de borradores"
      ]
    }
  },
