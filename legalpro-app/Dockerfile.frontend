# ── Build stage: compila el frontend Vite ──────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm install --ignore-scripts --legacy-peer-deps

# Copiar todo el fuente (src, public, index.html, vite.config, etc.)
COPY . .

# Todas las VITE_* vars deben pasarse en build-time via --build-arg
# Vite reemplaza import.meta.env.VITE_* en el bundle final — NO son runtime vars
ARG VITE_NODE_API_URL
ARG VITE_DOTNET_API_URL
ARG VITE_APK_URL
# Cache-buster: cambia para forzar re-ejecución de npm install y npm run build
ARG CACHE_BUST=1

ENV VITE_NODE_API_URL=$VITE_NODE_API_URL
ENV VITE_DOTNET_API_URL=$VITE_DOTNET_API_URL
ENV VITE_APK_URL=$VITE_APK_URL

RUN npm run build

# ── Runtime stage: nginx sirve dist correctamente ──────────────
FROM nginx:alpine AS final
WORKDIR /app

# Copiar build y config nginx (sirve la SPA en :3000 desde /app/dist).
# IMPORTANTE: el contexto de build es ./legalpro-app, por lo que `npm run build`
# usa legalpro-app/vite.config.js (base '/', tailwind) y NO el vite.config raíz
# (base '/Abogacia/' de GitHub Pages, incompatible con nginx en root).
# nginx.conf aquí es legalpro-app/nginx.conf (listen 3000, root /app/dist).
COPY --from=builder /app/dist /app/dist
COPY nginx.conf /etc/nginx/conf.d/default.conf

# nginx escucha en 3000 (Railway lo espera)
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:3000 || exit 1

CMD ["nginx", "-g", "daemon off;"]
