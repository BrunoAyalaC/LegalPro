{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schema de Audit Events",
  "type": "object",
  "required": ["version", "severidades", "eventos"],
  "properties": {
    "version": { "type": "string" },
    "descripcion": { "type": "string" },
    "severidades": {
      "type": "array",
      "items": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] }
    },
    "eventos": {
      "type": "array",
      "items": { "$ref": "#/$defs/Evento" }
    }
  },
  "$defs": {
    "Evento": {
      "type": "object",
      "required": ["nombre", "severidad", "categoria"],
      "properties": {
        "nombre": { "type": "string", "pattern": "^[A-Z_]+$" },
        "severidad": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] },
        "categoria": { "type": "string" },
        "iso27001_control": { "type": "string" },
        "lpdp_articulo": { "type": "string" },
        "retention_dias": { "type": "integer" },
        "alerta": { "type": "string" },
        "pii_masking": { "type": "array", "items": { "type": "string" } },
        "payload_required": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
