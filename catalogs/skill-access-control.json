    "regla_1_matriz_es_ley": "Un subagent solo invoca skills en skills_por_agente[agente].",
    "regla_2_loop_rol_no_da_skill": "Ser auditor/refutador en un loop NO autoriza a ejecutar la skill del builder; solo evalúa su output.",
    "regla_3_delegacion_obligatoria": "Si una tarea requiere skill ajena, el subagent retorna NEEDS_SKILL_DELEGATION al orquestador; jamás la invoca.",
    "regla_4_verificacion_doble": "Orquestador valida dispatch-time; verifiers validan CI-time.",
    "regla_5_violacion_escala": "Uso no autorizado → audit event SKILL_ACCESS_VIOLATION + reporte a @arquitecto-chief."
  },
