{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "last_updated": "2026-08-21",
  "titulo": "Loop Driven Development Engine (LDDE) — Configuración canónica",
  "descripcion": "Define el loop de calidad obligatorio que TODO output de skill debe recorrer antes de ship. 6 etapas: BUILD → AUDIT → REFUTE → OPTIMIZE → SECURE → GATE. Cada etapa tiene agentes responsables (todos subagents sin model propio), verifiers de gate y criterios de salida. Si GATE falla, el loop itera con los hallazgos (max max_iterations) y luego escala al chief del dominio.",
  "reglas_globales": {
    "primary_unico": "lexia-orchestrator orquesta TODOS los loops; ningún subagent ejecuta un loop completo por sí solo.",
    "sin_modelo_propio": "Todos los agentes del loop son mode:subagent con model:null — heredan del primary.",
    "gates_no_negociables": "Un gate FAIL bloquea el SHIP. No existe 'ship con warnings' para gates de seguridad/LPDP.",
    "audit_event_obligatorio": "Cada iteración emite audit event LDDE_ITERATION con stage, hallazgos, duración y veredicto.",
    "max_iterations_default": 3,
    "escalation_map": {
      "seguridad": "@arquitecto-chief",
      "lpdp": "@gobernanza-chief",
      "legal": "@abogado-chief",
      "arquitectura": "@arquitecto-chief",
      "performance": "@auditor-performance"
    }
  },
  "etapas": [
    { "id": "S1", "nombre": "BUILD", "descripcion": "El agente owner ejecuta la skill y produce el output.", "responsable": "skill.agente_owner", "salida": "output + self-check" },
    { "id": "S2", "nombre": "AUDIT", "descripcion": "Auditor del dominio valida contra catálogos canónicos y quality gates.", "responsable": "loop.auditores", "salida": "informe auditoría + score" },
    { "id": "S3", "nombre": "REFUTE", "descripcion": "Refutador adversarial intenta romper el output (casos borde, ataques, falsedad).", "responsable": "loop.refutadores", "salida": "vectores de ataque confirmados/refutados" },
    { "id": "S4", "nombre": "OPTIMIZE", "descripcion": "Optimizador mejora performance/costo sin sacrificar corrección.", "responsable": "loop.optimizadores", "salida": "output optimizado + métricas antes/después" },
    { "id": "S5", "nombre": "SECURE", "descripcion": "Pase de seguridad OWASP + LPDP sobre el output final.", "responsable": "loop.seguridad", "salida": "hallazgos seguridad con severidad" },
    { "id": "S6", "nombre": "GATE", "descripcion": "Verifiers automáticos deben dar PASS. Determina SHIP o nueva iteración.", "responsable": "tools/verifiers/*", "salida": "SHIP | ITERATE(hallazgos) | ESCALATE(chief)" }
  ],
